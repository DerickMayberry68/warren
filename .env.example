NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# Admin app only. Never prefix this credential with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your_server_only_supabase_secret

# Optional: only needed for server-only Drizzle queries.
# Use the Supabase transaction pooler for serverless deployments and disable prepared statements in the client.
DATABASE_URL=postgres://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
